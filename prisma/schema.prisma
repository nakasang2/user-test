generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// スキーマ変更の反映方法（重要）
//
// このプロジェクトは `prisma migrate` を使わず、ビルド時の
// `prisma db push --accept-data-loss`（package.json の build）で
// スキーマを本番へ反映する。migrations ディレクトリは置かない。
//
// 以前 SQLite 時代のマイグレーションが残っていたが、
// provider が sqlite のままで、モデルも 7/17 しか含まない
// 復元不能な状態だったため 2026-07-28 に削除した。
// （`prisma migrate` を実行すると失敗するか壊れた DB ができる罠になっていた）
//
// 将来 migrate 方式に移すなら、稼働中の DB から baseline を作る手順が必要。
// ─────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  // 実行時はプール接続（DATABASE_URL）。
  // db push/migration 用の直結 URL は prisma.config.ts の directUrl で指定する
  // （Neon の DATABASE_URL_UNPOOLED を使い、未設定時は DATABASE_URL にフォールバック）。
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 認証・マルチテナント
// ─────────────────────────────────────────────

model Organization {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  interviews Interview[]
  members    Member[]
  invites    Invite[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           String       @default("owner") // legacy – 実際の権限は Member.role を参照
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Member[]
  createdInvites Invite[]     @relation("InviteCreatedBy")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// 組織×ユーザーの多対多（将来の複数組織対応も見据えた junction table）
model Member {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("viewer") // owner | admin | editor | viewer
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

// 招待トークン（メール or リンク共有）
model Invite {
  id             String       @id @default(cuid())
  token          String       @unique @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("InviteCreatedBy", fields: [createdById], references: [id])
  email          String?      // 特定メールのみ有効にする場合
  role           String       @default("viewer") // viewer | editor | admin
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────────
// インタビュー
// ─────────────────────────────────────────────

model Interview {
  id               String        @id @default(cuid())
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  title            String
  description      String?
  type             String        @default("interview") // interview | impression | usability
  usabilityMode    String?       // prototype | service (only when type = usability)
  stimulusUrl      String?       // impression: image URL, prototype: Figma embed URL
  stimulusDuration Int?          // impression test: seconds to display (default 5)
  questions        Question[]
  sessions         Session[]
  tasks            Task[]
  screeners        ScreenerQuestion[]
  // 複数セッション比較の共通インサイトのキャッシュ。
  // insightsCount = キャッシュ生成時点の done セッション数（増減で再生成を判定）。
  commonInsights   String?
  insightsCount    Int?
  // 各タスク直後に SEQ（Single Ease Question: 1〜7 の主観的な易しさ）を聞くか。
  // 既存調査の進行を変えないため既定は無効。
  seqEnabled       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Question {
  id          String    @id @default(cuid())
  text        String
  order       Int
  type        String    @default("open") // open | rating | nps
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers     Answer[]
}

model Task {
  id          String       @id @default(cuid())
  interviewId String
  interview   Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  text        String
  order       Int
  results     TaskResult[]
}

// ─────────────────────────────────────────────
// 測定結果（定量分析の一次データ）
// 文字起こしとは独立に保持する。文字起こしは再生成・再文字起こしで
// 置き換わるが、ここは消えない＝成功率やスコアの集計が壊れない。
// ─────────────────────────────────────────────

// タスクの達成/断念と所要時間
model TaskResult {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskId      String?  // 元タスク（削除されても結果は残すため nullable）
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  order       Int      // タスク番号（1始まり）
  text        String   // 実施時点のタスク文言のスナップショット
  outcome     String   // completed | gave_up
  startedAt   Float?   // セッション開始からの経過秒
  endedAt     Float?
  durationSec Float?   // 所要時間（time on task）
  // SEQ: タスク直後の「どれくらい簡単でしたか」1（とても難しい）〜7（とても簡単）
  seq         Int?
  // 集計対象外にした日時。null なら集計に含める。
  // タスクを削除すると taskId は SetNull になり、どのタスクの結果だったか
  // 特定できなくなる（text は実施時点のスナップショットなので、文言を修正した
  // だけの現存タスクと区別できない）。そこで削除する「前」にここへ印を付ける。
  // リサーチャーが手動で外す／戻すこともできる。
  excludedAt  DateTime?
  createdAt   DateTime @default(now())

  // 1セッション1タスク1行。並行リクエストによる重複行を DB 側で防ぐ
  @@unique([sessionId, order])
  @@index([sessionId])
}

// 参加前に聞く属性・スクリーニング設問。
// 「対象者かどうかの判定」と「結果をセグメント別に見るための属性」を兼ねる。
model ScreenerQuestion {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  label       String    // 例: 普段この種のサービスを使いますか
  options     String[]  @default([])  // 選択肢
  // この選択肢が選ばれたら参加不可にする（空なら属性収集のみで足切りしない）
  disqualify  String[]  @default([])
  required    Boolean   @default(true)
  order       Int
  answers     ScreenerAnswer[]
}

// 被験者が回答した属性。セッションに紐づけてセグメント分析に使う。
model ScreenerAnswer {
  id         String            @id @default(cuid())
  sessionId  String
  session    Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String?
  question   ScreenerQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  label      String            // 設問文のスナップショット
  value      String            // 選んだ選択肢
  order      Int
  createdAt  DateTime          @default(now())

  @@index([sessionId])
}

// リサーチャーが付けるハイライト（引用＋メモ＋タグ）。
// 定性分析（コーディング／アフィニティ）の一次データで、AI 生成のテーマとは別物。
// AI テーマは再分析で上書きされるが、こちらは人が付けた記録なので消さない。
model Highlight {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // 紐づく発言。セグメントは再分析で作り直されるため、引用文はスナップショットで持つ
  segmentId String?
  quote     String   // 引用した発言
  note      String?  // リサーチャーのメモ
  tags      String[] @default([])
  startTime Float?   // 動画の該当位置（秒）
  createdBy String?  // 作成者の User.id（表示用。参照整合は取らない）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

// 質問への回答。rating/nps は valueNum に数値で入れて集計可能にする
model Answer {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  order      Int
  text       String    // 質問文のスナップショット
  type       String    // open | rating | nps
  valueNum   Float?    // rating(1-5) / nps(0-10) の数値
  valueText  String?   // 自由回答（深掘りのやり取りを含めた回答全体）
  // AI が追加で掘り下げた回数。0 = 一度で答えきった。人によって変わるため比較の材料になる。
  followUpCount Int?
  // 自由回答に対する AI の肯定/否定判定（positive | neutral | negative）。
  // 判定できなかった場合は null のままにし、画面では色を付けない。
  sentiment  String?
  // 集計対象外にした日時。null なら集計に含める（TaskResult.excludedAt と同じ理由）
  excludedAt DateTime?
  answeredAt Float?    // セッション開始からの経過秒
  createdAt  DateTime  @default(now())

  // 1セッション1質問1行。並行リクエストによる重複行を DB 側で防ぐ
  @@unique([sessionId, order])
  @@index([sessionId])
}

model Participant {
  id        String    @id @default(cuid())
  name      String
  email     String?
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Session {
  id            String          @id @default(cuid())
  interviewId   String
  participantId String?
  dailyRoomName String          @unique
  dailyRoomUrl  String
  status        String          @default("pending")
  // 被験者フロー（未認証）から status 更新・結果送信を行うための限定スコープ秘密トークン。
  // セッション作成時に生成し、被験者ページのサーバーコンポーネント経由でのみ受け渡す。
  participantToken String?      @unique
  // 読み取り専用の共有リンク用トークン（発行時のみ生成。null = 共有無効）。
  shareToken    String?         @unique
  // 共有リンクの有効期限。null = 無期限。期限切れのリンクは共有ページ側で拒否する。
  shareExpiresAt DateTime?
  recordingId   String?
  recordingUrl  String?
  // 参加同意（録画・表情分析・AI処理）を得た日時。null = 未取得。
  consentedAt   DateTime?
  // リサーチャー自身の試行（パイロット）。本番の集計・分析からは除外する。
  isPilot       Boolean         @default(false)
  transcript    Transcript?
  emotions      EmotionResult[]
  taskResults   TaskResult[]
  answers       Answer[]
  highlights    Highlight[]
  screenerAnswers ScreenerAnswer[]
  interview     Interview       @relation(fields: [interviewId], references: [id])
  participant   Participant?    @relation(fields: [participantId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Transcript {
  id        String              @id @default(cuid())
  sessionId String              @unique
  session   Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fullText  String
  segments  TranscriptSegment[]
  summary   String?
  themes    String?
  // インタビュー全体のトーン（positive | neutral | negative）と、その根拠の短い説明。
  // 発言ごとの判定は TranscriptSegment.sentiment 側に持つ（全体値のコピーはしない）。
  sentiment     String?
  sentimentNote String?
  createdAt DateTime            @default(now())
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker      String
  text         String
  startTime    Float
  endTime      Float
  sentiment    String?

  // 横断検索・セグメント全置換で毎回この列を辿るため索引を張る
  @@index([transcriptId])
}

model EmotionResult {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp Float
  happy     Float    @default(0)
  sad       Float    @default(0)
  angry     Float    @default(0)
  fearful   Float    @default(0)
  disgusted Float    @default(0)
  surprised Float    @default(0)
  neutral   Float    @default(0)
  createdAt DateTime @default(now())
}
